<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Top Header Bar: App Icon, Brand Name & Sleep Timer Badge -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <!-- Sleep Timer Status Badge -->
        <TextView
            android:id="@+id/widget_timer_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="定時：未設定"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Station Info Section -->
    <LinearLayout
        android:id="@+id/widget_station_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NHK World Radio Japan"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="廣播模式 • 即時英語收聽"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Controls Row: Prev, Play/Pause, Next, Sleep Timer -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <!-- Previous Station -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_btn_background"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="上一電台"
            android:scaleType="centerInside"
            android:layout_marginEnd="14dp" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_btn_play_bg"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="播放/暫停"
            android:scaleType="centerInside"
            android:layout_marginEnd="14dp" />

        <!-- Next Station -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_btn_background"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="下一電台"
            android:scaleType="centerInside"
            android:layout_marginEnd="14dp" />

        <!-- Sleep Timer Cycle -->
        <ImageButton
            android:id="@+id/widget_btn_timer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_btn_background"
            android:src="@drawable/ic_widget_timer"
            android:contentDescription="睡眠定時"
            android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>
